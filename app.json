{
  "expo": {
    "name": "TerraBuddy",
    "slug": "terrabuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.terrabuddy.app"
    },
    "ios": {
      "bundleIdentifier": "com.terrabuddy.app"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
